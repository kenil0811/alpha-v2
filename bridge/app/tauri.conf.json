{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha Bridge",
  "version": "0.2.0",
  "identifier": "io.github.kenil0811.alpha-bridge",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/bridge/": "bridge/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["alpha-bridge"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNTlBRkFGQkE2RTRFMzYKUldRMlRtNjZyNjlaVWpIeGlIMWthOWVCL3hyWTY4RTFYOVU3bWJFckxiUTZlWUFCaGRFSUUxNFYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
