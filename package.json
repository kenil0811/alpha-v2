{
  "name": "alpha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:core": "ALPHA_DEV_WINDOW=1 pnpm --filter @alpha/core dev",
    "dev:window": "pnpm --filter @alpha/window dev",
    "journey": "pnpm --filter @alpha/core journey",
    "start": "pnpm --filter @alpha/window build && pnpm --filter @alpha/core start",
    "shots": "node window/scripts/shots.ts",
    "kit": "node core/src/kit.ts",
    "release": "node scripts/release.ts",
    "fixture": "node scripts/fixture.ts",
    "kit-api": "node scripts/kit-api.ts",
    "mac": "cd mac && PATH=/usr/bin:$PATH cargo tauri build",
    "connector": "node core/src/connector.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@alpha/kit-sdk": "workspace:*",
    "zod": "catalog:"
  }
}
