{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "uses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kit": {
            "type": "string",
            "minLength": 1
          },
          "connector": {
            "type": "string",
            "minLength": 1
          },
          "min": {
            "type": "string"
          },
          "tables": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "name",
        "address"
      ]
    },
    "core": {
      "type": "boolean"
    },
    "people": {
      "type": "boolean"
    },
    "history": {
      "type": "object",
      "properties": {
        "renamed": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "in": {
                "type": "string"
              },
              "table": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "in"
            ]
          }
        },
        "removed": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "in": {
                "type": "string"
              },
              "table": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "in"
            ]
          }
        }
      }
    },
    "description": {
      "type": "string"
    },
    "business_case": {
      "type": "object",
      "properties": {
        "for": {
          "type": "string",
          "minLength": 1
        },
        "keeps": {
          "type": "string",
          "minLength": 1
        },
        "decides": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "for",
        "keeps",
        "decides"
      ]
    },
    "within": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "setup": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "money",
                    "date",
                    "choice",
                    "relation",
                    "person",
                    "file",
                    "link",
                    "email",
                    "phone",
                    "notes",
                    "summary"
                  ]
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tones": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "good",
                      "warn",
                      "bad",
                      "accent"
                    ]
                  }
                },
                "relates_to": {
                  "type": "string"
                },
                "many": {
                  "type": "boolean"
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "of": {
                      "type": "string"
                    },
                    "through": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "count",
                        "sum",
                        "min",
                        "max",
                        "latest"
                      ]
                    },
                    "field": {
                      "type": "string"
                    },
                    "by": {
                      "type": "string"
                    },
                    "where": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "is",
                            "is_not",
                            "contains",
                            "not_contains",
                            "starts",
                            "ends",
                            "eq",
                            "ne",
                            "gt",
                            "lt",
                            "between",
                            "before",
                            "after",
                            "in",
                            "all_of",
                            "none_of",
                            "empty",
                            "not_empty"
                          ]
                        },
                        "value": {
                          "type": [
                            "string",
                            "number",
                            "null"
                          ]
                        },
                        "value2": {
                          "type": [
                            "string",
                            "number",
                            "null"
                          ]
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "field",
                        "op"
                      ]
                    }
                  },
                  "required": [
                    "of",
                    "op"
                  ]
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "person"
                  ]
                },
                "part_of": {
                  "type": "boolean"
                },
                "indexed": {
                  "type": "boolean"
                },
                "key": {
                  "type": "string"
                },
                "about": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "kind"
              ]
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "people": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "each": {
                    "type": "string",
                    "const": "person"
                  },
                  "name": {
                    "type": "string"
                  },
                  "emails": {
                    "type": "string"
                  },
                  "phones": {
                    "type": "string"
                  },
                  "profile": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "you": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "is": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "is"
                    ]
                  }
                },
                "required": [
                  "each"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "each": {
                    "type": "string",
                    "const": "exchange"
                  },
                  "channel": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "with": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sent": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "is": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "is"
                    ]
                  },
                  "by": {
                    "type": "string"
                  },
                  "about": {
                    "type": "string"
                  },
                  "you": {
                    "type": "string"
                  }
                },
                "required": [
                  "each",
                  "channel",
                  "at"
                ]
              }
            ]
          },
          "views": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "default": {
                  "type": "boolean"
                },
                "about": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "name",
          "fields"
        ]
      }
    },
    "network": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "version"
  ]
}
